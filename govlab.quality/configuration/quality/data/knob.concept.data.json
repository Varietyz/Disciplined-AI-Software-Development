{
    "meta": {
        "note": "Hand-authored knob overlay for the tunable concepts, taken from each tool's own schema or source. A default is null where the source inlines none or measures a different metric, and `fixed: true` marks a tool with no configurable threshold for the concept. The catalog pipeline merges this overlay with the rule catalog.",
        "verified": "doc-only"
    },
