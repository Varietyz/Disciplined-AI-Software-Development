{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "customConditions": ["development"],
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "noUncheckedIndexedAccess": false,
        "noPropertyAccessFromIndexSignature": false
    },
    "include": ["**/*.ts"],
    "exclude": [
        "**/node_modules",
        "**/dist",
        "**/build"
    ]
}
