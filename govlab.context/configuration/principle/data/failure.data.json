        {
            "id": "backpressure",
            "distinctFrom": [
                {
                    "id": "architecture:event-stream",
                    "reason": "Backpressure is a consumer slowing its producer, while an event stream is the replayable log consumers read from their own offset."
                },
                {
                    "id": "architecture:message-queue",
                    "reason": "Backpressure signals capacity back to the producer, while a message queue holds messages until a consumer takes them."
