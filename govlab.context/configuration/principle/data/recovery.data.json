                "after": "const store = new FooStore({\n  volume: raidArray({ level: 10, disks: [\"/dev/sda\", \"/dev/sdb\", \"/dev/sdc\", \"/dev/sdd\"] }),\n});",
                "lang": "ts"
            }
        }
    ]
