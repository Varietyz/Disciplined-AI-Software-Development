{
    "check": {
        "by": ["the structured-document validator, which requires the gate clause each node grounds wherever a document writes, reads, stops or reports"],
        "population": "every structured document whose constructs ground the node",
        "freshness": "a verdict stands until the document, the grammar or the node changes",
        "refusal": "the validator fails a gate that omits the clause the node asks for",
        "observation": "none: a node is a question a gate asks; the answer comes from the check the gate runs",
        "evidence": "fires-and-accepts: a suite plants a check with no evidence, a gate with no population, a write with no refusal and a node with no gate, and validates a well-formed document clean",
        "authority": "the gate clause the node asks for, which every document's gate conforms to"
    },
