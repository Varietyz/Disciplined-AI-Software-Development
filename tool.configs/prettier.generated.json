{
  "config": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "objectWrap": "collapse",
    "printWidth": 120,
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "all",
    "useTabs": false,
    "overrides": [
      { "files": "*.ts", "options": { "parser": "typescript" } },
      { "files": "*.css", "options": { "parser": "css" } }
    ]
  },
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.cache/**",
    "**/coverage/**",
    "**/_code.info.generated/**",
    "**/*.generated.*",
    "**/__fixtures__/**",
    "**/fixtures/**",
    "**/testdata/**",
    "**/.git/**",
    "**/.vscode/**",
    "**/logs/**",
    "**/_builds/**",
    "**/_third-party/**",
    "**/_excluded.drafts/**",
    "**/disciplined.methodology/**",
    "**/.quality-reports/**",
    ".govlab/_quality.reports.generated/**",
    "**/_experimental*/**",
    "**/target/**",
    "**/_build/**",
    "**/deps/**",
    "**/.vite/**",
    "**/.registry/**",
    "**/.nyc_output/**",
    "**/out/**",
    "**/tmp/**",
    "*.log",
    ".DS_Store",
    "Thumbs.db"
  ]
}
