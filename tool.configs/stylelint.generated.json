{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.cache/**",
    "**/coverage/**",
    "**/_code.info.generated/**",
    "**/*.generated.*",
    "**/__fixtures__/**",
    "**/fixtures/**",
    "**/testdata/**",
    "**/.git/**",
    "**/.vscode/**",
    "**/logs/**",
    "**/_builds/**",
    "**/_third-party/**",
    "**/_excluded.drafts/**",
    "**/disciplined.methodology/**",
    "**/.quality-reports/**",
    ".govlab/_quality.reports.generated/**",
    "**/_experimental*/**",
    "**/target/**",
    "**/_build/**",
    "**/deps/**",
    "**/.vite/**",
    "**/.registry/**",
    "**/.nyc_output/**",
    "**/out/**",
    "**/tmp/**"
  ],
  "overrides": [
    {
      "files": ["**/*.tokens.css"],
      "rules": {
        "declaration-property-value-disallowed-list": null,
        "govlab/no-css-magic-number": null,
        "scale-unlimited/declaration-strict-value": null
      }
    }
  ],
  "plugins": [
    "stylelint-declaration-strict-value",
    "stylelint-order",
    "stylelint-no-unsupported-browser-features",
    { "ruleName": "govlab/consistent-naming" },
    { "ruleName": "govlab/custom-property-order" },
    { "ruleName": "govlab/custom-property-unit-mismatch" },
    { "ruleName": "govlab/no-css-magic-number" },
    { "ruleName": "govlab/no-custom-property-alias" },
    { "ruleName": "govlab/no-custom-property-redefinition" },
    { "ruleName": "govlab/no-held-entrance-fill" },
    { "ruleName": "govlab/no-large-viewport-unit" },
    { "ruleName": "govlab/no-magic-z-index" },
    { "ruleName": "govlab/no-native-appearance" },
    { "ruleName": "govlab/no-shadow" },
    { "ruleName": "govlab/require-native-reset" },
    { "ruleName": "govlab/responsive-pattern" },
    { "ruleName": "govlab/responsive-units" },
    { "ruleName": "govlab/shrinkable-grid-track" },
    { "ruleName": "local/no-unresolved-import" }
  ],
  "rules": {
    "color-hex-length": ["short"],
    "custom-property-pattern": ["^[a-z][a-z0-9-]*$"],
    "declaration-block-no-duplicate-custom-properties": [true],
    "declaration-no-important": [true],
    "font-family-no-duplicate-names": [true],
    "function-url-quotes": ["always"],
    "keyframes-name-pattern": ["^[a-z][a-z0-9-]*$"],
    "max-nesting-depth": [3],
    "number-max-precision": [3],
    "property-no-vendor-prefix": [true],
    "selector-class-pattern": [
      "^[a-z][a-z0-9\\-]*(?:__[a-z0-9\\-]+)?(?:--[a-z0-9\\-]+)?$"
    ],
    "selector-max-id": [0],
    "selector-max-type": [2],
    "selector-no-qualifying-type": [true],
    "value-no-vendor-prefix": [true],
    "govlab/consistent-naming": true,
    "govlab/custom-property-order": true,
    "govlab/custom-property-unit-mismatch": true,
    "govlab/no-css-magic-number": true,
    "govlab/no-custom-property-alias": true,
    "govlab/no-custom-property-redefinition": true,
    "govlab/no-held-entrance-fill": true,
    "govlab/no-large-viewport-unit": true,
    "govlab/no-magic-z-index": true,
    "govlab/no-native-appearance": true,
    "govlab/no-shadow": true,
    "govlab/require-native-reset": true,
    "govlab/responsive-pattern": true,
    "govlab/responsive-units": true,
    "govlab/shrinkable-grid-track": true,
    "local/no-unresolved-import": true,
    "declaration-property-value-disallowed-list": {
      "/^(?!--).*/": [
        "/#[0-9A-Fa-f]+/",
        "/rgb\\(/",
        "/hsl\\(/",
        "/\\d+(px|em|rem|%)\\b/"
      ]
    },
    "order/properties-alphabetical-order": true,
    "plugin/no-unsupported-browser-features": null,
    "scale-unlimited/declaration-strict-value": [
      [
        "/color$/",
        "fill",
        "stroke",
        "padding",
        "padding-block",
        "padding-inline",
        "padding-top",
        "padding-right",
        "padding-bottom",
        "padding-left",
        "margin",
        "margin-block",
        "margin-inline",
        "margin-top",
        "margin-right",
        "margin-bottom",
        "margin-left",
        "gap",
        "row-gap",
        "column-gap",
        "font-family",
        "font-size",
        "font-weight",
        "letter-spacing",
        "border",
        "border-width",
        "border-radius",
        "background",
        "background-color",
        "background-image",
        "outline",
        "outline-width",
        "outline-offset",
        "top",
        "right",
        "bottom",
        "left",
        "inset",
        "width",
        "min-width",
        "max-width",
        "height",
        "min-height",
        "max-height",
        "inline-size",
        "block-size",
        "z-index",
        "opacity",
        "transform",
        "transition-duration",
        "transition-delay",
        "transition-timing-function",
        "animation-duration",
        "animation-delay",
        "animation-timing-function",
        "box-shadow",
        "text-shadow"
      ],
      {
        "disableFix": true,
        "ignoreFunctions": true,
        "ignoreValues": [
          "inherit",
          "transparent",
          "currentColor",
          "currentcolor",
          "initial",
          "unset",
          "none",
          "auto",
          "solid",
          "dashed",
          "dotted",
          "0",
          "1",
          "1em",
          "0.01ms",
          "fit-content",
          "max-content",
          "min-content",
          "/%$/",
          "/vw$/",
          "/vh$/",
          "/dvw$/",
          "/dvh$/",
          "/dvb$/"
        ],
        "ignoreVariables": true
      }
    ]
  }
}
