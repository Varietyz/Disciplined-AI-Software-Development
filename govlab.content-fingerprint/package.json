{
    "name": "@govlab/content-fingerprint",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Deterministic content-hash fingerprinting and a per-key skip index for idempotent, selective regeneration.",
    "license": "CC-BY-SA-4.0",
    "imports": {
        "#configuration/*": "./configuration/*.ts",
        "#core/*": "./core/*.ts",
        "#types/*": "./types/*.ts"
    },
    "main": "./index.ts",
    "exports": {
        ".": "./index.ts",
        "./*": "./*"
    },
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@govlab/canonical-write": "*",
        "@ssot/paths": "*"
    }
}
