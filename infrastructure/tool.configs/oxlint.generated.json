{
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error",
    "suspicious": "error"
  },
  "env": { "browser": true, "builtin": true, "esnext": true, "node": true },
  "globals": {},
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.cache/**",
    "**/coverage/**",
    "**/_code.info.generated/**",
    "**/*.generated.*",
    "**/*.backup.*",
    "**/__fixtures__/**",
    "**/fixtures/**",
    "**/testdata/**",
    "**/.git/**",
    "**/.vscode/**",
    "**/logs/**",
    "**/_builds/**",
    "**/_third-party/**",
    "**/_excluded.drafts/**",
    "**/disciplined.methodology/**",
    "**/.quality-reports/**",
    ".govlab/_quality.reports.generated/**",
    "**/_experimental*/**",
    "**/target/**",
    "**/_build/**",
    "**/deps/**",
    "**/.vite/**",
    "**/.registry/**",
    "**/.nyc_output/**",
    "**/out/**",
    "**/tmp/**",
    "**/*.d.ts",
    "**/*.config.ts"
  ],
  "plugins": ["typescript", "oxc", "unicorn"],
  "rules": {
    "eslint/func-style": "off",
    "eslint/id-length": "off",
    "eslint/max-depth": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-params": "off",
    "eslint/max-statements": "off",
    "eslint/class-methods-use-this": "off",
    "eslint/no-bitwise": "off",
    "eslint/no-console": "off",
    "eslint/no-continue": "off",
    "eslint/no-duplicate-imports": "off",
    "eslint/no-empty-function": "off",
    "eslint/no-use-before-define": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/no-nested-ternary": "off",
    "eslint/no-plusplus": "off",
    "eslint/no-ternary": "off",
    "eslint/no-undefined": "off",
    "eslint/no-void": "off",
    "eslint/radix": "off",
    "eslint/require-await": "off",
    "eslint/sort-imports": "off",
    "eslint/sort-keys": "off",
    "oxc/no-async-await": "off",
    "oxc/no-async-endpoint-handlers": "off",
    "oxc/no-map-spread": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "typescript/dot-notation": "off",
    "typescript/explicit-function-return-type": [
      "error",
      {
        "allowExpressions": true,
        "allowHigherOrderFunctions": true,
        "allowTypedFunctionExpressions": true
      }
    ],
    "typescript/method-signature-style": "off",
    "unicorn/prefer-code-point": "off",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "name": "test", "package": "node:test" },
          { "from": "package", "name": "it", "package": "node:test" },
          { "from": "package", "name": "describe", "package": "node:test" },
          { "from": "package", "name": "before", "package": "node:test" },
          { "from": "package", "name": "after", "package": "node:test" },
          { "from": "package", "name": "beforeEach", "package": "node:test" },
          { "from": "package", "name": "afterEach", "package": "node:test" }
        ]
      }
    ],
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/require-await": "off",
    "unicorn/import-style": "off",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/no-array-for-each": "off",
    "unicorn/no-array-reduce": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-await-expression-member": "off",
    "unicorn/no-null": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/no-process-exit": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/prefer-math-trunc": "off",
    "unicorn/prefer-modern-math-apis": "off",
    "unicorn/prefer-native-coercion-functions": "off",
    "unicorn/prefer-query-selector": "off",
    "unicorn/prefer-top-level-await": "off",
    "unicorn/require-post-message-target-origin": "off"
  }
}
