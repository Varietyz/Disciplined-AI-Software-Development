        { "joiner": ".", "letters": "upper", "name": "screaming-dot" },
        { "joiner": "-", "letters": "lower", "name": "kebab" },
        { "joiner": "-", "letters": "upper", "name": "screaming-kebab" },
        { "joiner": "_", "letters": "lower", "name": "snake" },
        { "joiner": "_", "letters": "upper", "name": "screaming-snake" },
        { "joiner": null, "letters": "upper", "name": "pascal" },
        { "joiner": null, "letters": "lower", "name": "camel" }
