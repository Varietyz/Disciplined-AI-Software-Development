{
  "absolute": true,
  "format": ["typescript", "javascript", "css", "html"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.cache/**",
    "**/coverage/**",
    "**/_code.info.generated/**",
    "**/*.generated.*",
    "**/*.backup.*",
    "**/__fixtures__/**",
    "**/fixtures/**",
    "**/testdata/**",
    "**/.git/**",
    "**/.vscode/**",
    "**/logs/**",
    "**/_builds/**",
    "**/_third-party/**",
    "**/_excluded.drafts/**",
    "**/disciplined.methodology/**",
    "**/.quality-reports/**",
    ".govlab/_quality.reports.generated/**",
    "**/_experimental*/**",
    "**/target/**",
    "**/_build/**",
    "**/deps/**",
    "**/.vite/**",
    "**/.registry/**",
    "**/.nyc_output/**",
    "**/out/**",
    "**/tmp/**",
    "**/*.test.ts",
    "**/_index.generated.ts"
  ],
  "minLines": 5,
  "minTokens": 50,
  "output": ".govlab/_quality.reports.generated",
  "reporters": ["json"],
  "threshold": 0
}
