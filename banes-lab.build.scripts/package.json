{
    "name": "@banes-lab/build-scripts",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "The build steps the site runs on every build and dev start.",
    "license": "CC-BY-SA-4.0",
    "imports": {
        "#configuration/*": "./configuration/*.ts",
        "#core/*": "./core/*.ts",
        "#runtime/*": "./runtime/*.ts",
        "#types/*": "./types/*.ts"
    },
    "exports": {
        "./*": "./*"
    },
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@banes-lab/content": "*",
        "@banes-lab/web": "*",
        "@govlab/argv": "*",
        "@govlab/canonical-write": "*",
        "@govlab/constants": "*",
        "@govlab/content-fingerprint": "*",
        "@govlab/context": "*",
        "@govlab/docs": "*",
        "@govlab/patterns": "*",
        "@govlab/pipeline": "*",
        "@govlab/quality": "*",
        "@govlab/stats": "*",
        "@ssot/govlab": "*",
        "@ssot/paths": "*",
        "@ssot/secrets": "*"
    }
}
